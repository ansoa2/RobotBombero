<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="placeholder" class="screen placeholder">
        <ui:VisualElement class="panel placeholder__card">
            <ui:Label name="placeholder-title" class="placeholder__title" />
            <ui:Label text="Esta pantalla estará disponible muy pronto." class="text-muted" />
            <ui:Button name="placeholder-back" class="btn">
                <ui:Label text="Volver" class="btn__label" picking-mode="Ignore" />
                <ui:Label text="←" class="btn__icon" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
