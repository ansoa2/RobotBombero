/* Identidad "Ciudad en llamas". Clases comunes para todas las pantallas: .panel, .btn, .btn--main. */

:root {
    --color-night: #090C16;
    --color-action: #FF7A2F;
    --color-action-end: #E63D24;
    --color-accent: #FFB37A;
    --color-text: #FFFFFF;
    --color-muted: rgba(255, 255, 255, 0.72);
    --color-line: rgba(255, 255, 255, 0.2);
    --color-panel: rgba(9, 12, 22, 0.78);
    --color-control: rgba(255, 255, 255, 0.1);
    --font-regular: url("project://database/Assets/Game/UI/Fonts/Inter-Regular.ttf");
    --font-strong: url("project://database/Assets/Game/UI/Fonts/Inter-SemiBold.ttf");

    -unity-font-definition: var(--font-regular);
    font-size: 16px;
    color: var(--color-text);
}

/* --- Marco --- */

.app {
    flex-grow: 1;
    background-color: var(--color-night);
}

.app__background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.app__safe,
.app__host,
.screen-root,
.screen {
    flex-grow: 1;
}

/* --- Comunes --- */

.panel {
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    padding: 16px;
}

.btn {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 52px;
    margin: 0;
    padding: 0 16px;
    background-color: var(--color-control);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 14px;
    color: var(--color-text);
    font-size: 17px;
    -unity-font-definition: var(--font-strong);
    -unity-text-align: middle-left;
    white-space: normal;
}

/* Con :enabled: el tema por defecto de Unity usa :hover:enabled y, sin esto, deja el botón gris claro con texto blanco. */
.btn:hover:enabled {
    background-color: rgba(255, 255, 255, 0.18);
    border-color: var(--color-accent);
}

.btn:focus,
.btn:focus:enabled {
    border-color: var(--color-accent);
}

.btn:active:enabled,
.btn:hover:active:enabled {
    background-color: rgba(255, 255, 255, 0.26);
}

.btn:disabled {
    opacity: 0.6;
}

.btn--main {
    background-color: var(--color-action);
    background-image: url("project://database/Assets/Game/UI/Images/btn-main.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
}

.btn--main:hover:enabled {
    background-color: var(--color-action);
    -unity-background-image-tint-color: rgb(255, 225, 205);
    border-width: 0;
}

.btn--main:active:enabled,
.btn--main:hover:active:enabled {
    background-color: var(--color-action-end);
    -unity-background-image-tint-color: rgb(225, 190, 170);
}

.btn--center {
    -unity-text-align: middle-center;
    justify-content: center;
}

.btn__label {
    -unity-font-definition: var(--font-strong);
    padding: 0;
    margin: 0;
}

.btn__icon {
    font-size: 14px;
    opacity: 0.85;
    padding: 0;
    margin: 0;
}

.text-muted {
    color: var(--color-muted);
    font-size: 14px;
    white-space: normal;
    padding: 0;
    margin: 0;
}

.text-note {
    color: var(--color-muted);
    font-size: 12px;
    white-space: normal;
    padding: 0;
    margin: 12px 0 0 0;
}

/* --- Logo --- */

.logo__tag {
    color: var(--color-accent);
    -unity-font-definition: var(--font-strong);
    font-size: 12px;
    letter-spacing: 2px;
    padding: 0;
    margin: 0 0 6px 0;
    text-shadow: 0 1px 6px rgba(9, 12, 22, 0.9);
}

.logo__word {
    color: var(--color-text);
    -unity-font-definition: var(--font-strong);
    font-size: 44px;
    letter-spacing: -0.5px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    text-shadow: 0 2px 10px rgba(9, 12, 22, 0.9);
}

/* --- Pantallas con columna: acceso y menú --- */

.shell {
    padding: 28px 18px 22px 18px;
}

.shell__column {
    flex-grow: 1;
}

.shell__spacer {
    flex-grow: 1;
    min-height: 8px;
}

.is-landscape .shell {
    flex-direction: row;
    padding: 0;
}

.is-landscape .shell__column {
    flex-grow: 0;
    flex-shrink: 0;
    width: 48%;
    min-width: 360px;
    max-width: 520px;
    justify-content: center;
    padding: 12px 92px 12px 28px;
    background-image: url("project://database/Assets/Game/UI/Images/panel-fade.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.is-landscape .shell__spacer {
    flex-grow: 0;
    min-height: 10px;
}

.is-landscape .logo__title {
    flex-direction: row;
}

.is-landscape .logo__word {
    font-size: 30px;
    margin-right: 8px;
}

.is-landscape .logo__tag {
    margin-bottom: 2px;
}

.is-landscape .menu__player {
    margin-top: 2px;
}

/* --- Menú --- */

.menu__player {
    color: var(--color-muted);
    font-size: 13px;
    padding: 0;
    margin: 8px 0 0 1px;
    text-shadow: 0 1px 6px rgba(9, 12, 22, 0.9);
}

.menu__player--offline {
    -unity-font-style: italic;
}

.menu__buttons > .btn {
    margin-bottom: 10px;
}

.is-landscape .menu__buttons > .btn {
    min-height: 44px;
    margin-bottom: 7px;
    font-size: 15px;
}

/* --- Acceso --- */

.login__form {
    flex-shrink: 0;
}

.login__title {
    -unity-font-definition: var(--font-strong);
    font-size: 19px;
    white-space: normal;
    padding: 0;
    margin: 0 0 4px 0;
}

.login__message {
    color: var(--color-accent);
    font-size: 14px;
    white-space: normal;
    padding: 0;
    margin: 0 0 10px 0;
}

.field {
    margin: 12px 0 12px 0;
    padding: 0;
}

.field .unity-base-text-field__input {
    min-height: 48px;
    padding: 0 14px;
    background-color: var(--color-control);
    border-width: 1px;
    border-color: var(--color-line);
    border-radius: 12px;
    color: var(--color-text);
    font-size: 17px;
    -unity-text-align: middle-left;
    --unity-cursor-color: var(--color-accent);
    --unity-selection-color: rgba(255, 122, 47, 0.45);
}

.field .unity-base-text-field__input--placeholder {
    color: rgba(255, 255, 255, 0.45);
}

.field:focus .unity-base-text-field__input,
.field .unity-base-text-field__input:focus,
.field .unity-base-text-field__input:focus:enabled {
    border-color: var(--color-accent);
}

.is-landscape .login__form {
    padding: 12px 14px;
}

.is-landscape .login__title {
    font-size: 16px;
}

.is-landscape .text-muted {
    font-size: 13px;
}

.is-landscape .text-note {
    font-size: 11px;
    margin-top: 8px;
}

.is-landscape .field {
    margin: 8px 0 8px 0;
}

.is-landscape .field .unity-base-text-field__input {
    min-height: 44px;
    font-size: 15px;
}

.is-landscape .login__form .btn {
    min-height: 44px;
    font-size: 15px;
}

.is-landscape .login__message {
    font-size: 13px;
    margin-bottom: 6px;
}

/* --- Provisional --- */

/* Abajo en vertical y a la izquierda en horizontal: las zonas tranquilas de cada fondo. */
.placeholder {
    align-items: center;
    justify-content: flex-end;
    padding: 18px;
}

.placeholder__card {
    width: 100%;
    max-width: 420px;
}

.is-landscape .placeholder {
    align-items: flex-start;
    justify-content: center;
    padding: 18px 18px 18px 28px;
}

.is-landscape .placeholder__card {
    width: 340px;
}

.placeholder__title {
    -unity-font-definition: var(--font-strong);
    font-size: 26px;
    white-space: normal;
    padding: 0;
    margin: 0 0 8px 0;
}

.placeholder__card .btn {
    margin-top: 18px;
}

/* --- Tableta vertical (relación de aspecto cercana a 3:4) ---
   El fondo recorta más ancho: el logo en una línea y los botones en 2 x 2 dejan libres el casco y los pies del robot. */

.is-tablet .logo__title {
    flex-direction: row;
}

.is-tablet .logo__word {
    font-size: 42px;
    margin-right: 10px;
}

.is-tablet .menu__buttons {
    flex-direction: row;
    flex-wrap: wrap;
}

.is-tablet .menu__buttons > .btn {
    flex-grow: 1;
    flex-basis: 45%;
    margin-right: 10px;
}

/* --- Campo con etiqueta encima (dirección del servidor) --- */

.field--stacked {
    flex-direction: column;
    align-items: stretch;
}

.field--stacked > .unity-base-field__label {
    min-width: 0;
    width: auto;
    color: var(--color-muted);
    font-size: 13px;
    padding: 0 0 4px 1px;
    margin: 0;
    -unity-text-align: middle-left;
}

.is-landscape .field--stacked > .unity-base-field__label {
    padding-bottom: 2px;
}

.menu__buttons > .btn--small {
    margin-top: 2px;
}
